# Lakodi – základní serverový .env pro Docker deploy
# Zkopírujte do .env a vyplňte reálné hodnoty.

# Admin přihlášení (email + heslo, role-based)
ADMIN_EMAIL=lakodi@seznam.cz
ADMIN_PASSWORD=admin123
ADMIN_RECOVERY_TOKEN=vase-tajny-recovery-token
ADMIN_SESSION_SECRET=zmente-na-nahodny-retezec

# Interni service-to-service autentizace pro AI ucetni platformu.
# Stejny signing secret musi byt nastaven pouze server-side v AI backendu
# (ACCOUNTING_CONNECTOR_SIGNING_SECRET / KEY_ID / TENANT_ID).
AI_ACCOUNTING_SERVICE_TOKEN_SECRET=
AI_ACCOUNTING_EXPECTED_TENANT_ID=
AI_ACCOUNTING_ALLOWED_KEY_ID=
AI_ACCOUNTING_TOKEN_ISSUER=ai-agent-accounting
AI_ACCOUNTING_TOKEN_AUDIENCE=lakodi-internal-accounting
AI_ACCOUNTING_MAX_TOKEN_TTL_SECONDS=300

# Host → AI Agent Accounting (BFF mintuje short-lived AI_AUTH JWT pro admin chat).
# Musí sedět 1:1 s AI_AUTH_* na AI platformě. Nikdy nedávej do frontendu.
AI_AUTH_TOKEN_ISSUER=lakodi-host
AI_AUTH_TOKEN_AUDIENCE=ai-agent-accounting
AI_AUTH_KEY_ID=
AI_AUTH_SIGNING_SECRET=
AI_AUTH_TENANT_ID=
AI_AUTH_TOKEN_TTL_SECONDS=300
AI_AUTH_DEFAULT_SCOPES=ai.chat,lakodi.invoices.read,lakodi.payments.read,lakodi.customers.read
# Základní URL AI platformy (bez trailing slash), dostupná jen z Lakodi backendu.
# Docker shared network alias (viz docker-compose.dev.yml + AI docker-compose.lakodi-bridge.yml):
# AI_AGENT_BASE_URL=http://ai-agent-accounting-api:8000
AI_AGENT_BASE_URL=
AI_AGENT_TIMEOUT_SECONDS=60

# Recovery přes email (Resend API)
ADMIN_RECOVERY_EMAILS=lakodi@seznam.cz
RESEND_API_KEY=
ADMIN_FROM_EMAIL=Lakodi <noreply@vasadomena.cz>
ADMIN_RECOVERY_BASE_URL=https://admin.vasadomena.cz
BOOKING_ADMIN_BASE_URL=https://admin.vasadomena.cz
BOOKING_NOTIFICATION_EMAIL=lakodi@seznam.cz

# Volitelně lze změnit číslo pro ruční WhatsApp odkaz v adminu
WHATSAPP_NUMBER=420776053625

# Recovery link pro přihlášení bez hesla:
# https://vasadomena.cz/admin?recovery=vase-tajny-recovery-token

COMPOSE_PROJECT_NAME=lakodi
IMAGE_TAG=main
PREVIOUS_IMAGE_TAG=
BACKEND_BIND_PORT=8016
FRONTEND_BIND_PORT=8090
BACKEND_HEALTHCHECK_URL=http://127.0.0.1:8016/api/health
FRONTEND_HEALTHCHECK_URL=http://127.0.0.1:8090
DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/data/uploads
NEXT_PUBLIC_API_URL=https://lakodi.cz
REDIS_URL=redis://lakodi-redis:6379/0
ARES_PROVIDER=real
INVOICE_OWNER_EMAIL=lakodi@seznam.cz
INVOICE_PAYMENT_METHOD=Převodem
INVOICE_BANK_ACCOUNT_NUMBER=5997826359
INVOICE_BANK_CODE=0800

# CORS pro frontend
CORS_ORIGINS=https://lakodi.cz,https://www.lakodi.cz,https://admin.lakodi.cz
