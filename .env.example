# Lakodi – společný lokální základ pro vývoj
# Zkopírujte do .env a případné lokální odlišnosti dejte do .env.dev.

# Admin přihlášení (email + heslo, role-based)
ADMIN_EMAIL=lakodi@seznam.cz
ADMIN_PASSWORD=admin123
ADMIN_RECOVERY_TOKEN=vase-tajny-recovery-token
ADMIN_SESSION_SECRET=zmente-na-nahodny-retezec

# Recovery přes email (Resend API)
# ADMIN_RECOVERY_EMAILS=lakodi@seznam.cz
# RESEND_API_KEY=re_xxxxx
# ADMIN_FROM_EMAIL=Lakodi <noreply@vasadomena.cz>
# ADMIN_RECOVERY_BASE_URL=https://vasadomena.cz

# Recovery link pro přihlášení bez hesla:
# https://vasadomena.cz/admin?recovery=vase-tajny-recovery-token

DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
NEXT_PUBLIC_API_URL=http://localhost:8016
REDIS_URL=redis://127.0.0.1:6382/0
ARES_PROVIDER=real

# CORS pro frontend
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:3000,http://127.0.0.1:3000

# Docker Hub repozitáře pro build/deploy script
# DOCKERHUB_FE_REPO=lakyn80/lakodi-frontend
# DOCKERHUB_BE_REPO=lakyn80/lakodi-backend

# Server deploy (ssh)
# DEPLOY_SERVER_USER=lucky
# DEPLOY_SERVER_HOST=89.221.214.140
# DEPLOY_SERVER_PATH=/opt/lakodi
# DEPLOY_SSH_KEY_PATH=
# DEPLOY_DB_LOCAL_PATH=.\data\app.db
