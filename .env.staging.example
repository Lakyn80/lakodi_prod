# Lakodi staging env sample
# Copy to staging .env on server or to GitHub Environment secret SERVER_ENV_FILE.

COMPOSE_PROJECT_NAME=lakodi-staging

BACKEND_IMAGE=ghcr.io/vas-org/lakodi-backend
FRONTEND_IMAGE=ghcr.io/vas-org/lakodi-frontend
IMAGE_TAG=develop
PREVIOUS_IMAGE_TAG=

BACKEND_BIND_PORT=18016
FRONTEND_BIND_PORT=18090

BACKEND_HEALTHCHECK_URL=http://127.0.0.1:18016/api/health
FRONTEND_HEALTHCHECK_URL=http://127.0.0.1:18090

DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/data/uploads
REDIS_URL=redis://lakodi-redis:6379/0
INVOICE_OWNER_EMAIL=lakodi@seznam.cz
INVOICE_PAYMENT_METHOD=Převodem
INVOICE_BANK_ACCOUNT_NUMBER=5997826359
INVOICE_BANK_CODE=0800

# Na stagingu může být real nebo mock podle dostupnosti upstreamu.
ARES_PROVIDER=real

NEXT_PUBLIC_API_URL=https://staging-api.vase-domena.cz
CORS_ORIGINS=https://staging.vase-domena.cz,https://admin.staging.vase-domena.cz

ADMIN_EMAIL=admin@staging.vase-domena.cz
ADMIN_PASSWORD=zmente-na-silne-heslo
ADMIN_RECOVERY_TOKEN=zmente-na-dlouhy-nahodny-token
ADMIN_RECOVERY_EMAILS=admin@staging.vase-domena.cz
RESEND_API_KEY=
ADMIN_FROM_EMAIL=Lakodi <noreply@staging.vase-domena.cz>
ADMIN_RECOVERY_BASE_URL=https://admin.staging.vase-domena.cz
ADMIN_COOKIE_SECURE=true

SMTP_HOST=
SMTP_PORT=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
