FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-dejavu-core \
    libheif-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        fastapi \
        uvicorn \
        httpx \
        python-multipart \
        pillow \
        pillow-heif \
        reportlab \
        sqlalchemy \
        resend \
        passlib \
        redis \
        pytest \
        "bcrypt==4.0.1"

EXPOSE 8016

CMD ["uvicorn", "backend.app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8016"]
