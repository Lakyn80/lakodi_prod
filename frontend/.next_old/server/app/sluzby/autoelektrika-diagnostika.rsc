7:["$","$L12",null,{"service":{"id":"autoelektrika","slug":"autoelektrika-diagnostika","iconName":"Zap","title":{"cs":"Autoelektrika a diagnostika","ua":"Автоелектрика та діагностика","ru":"Автоэлектрика и диагностика","en":"Auto electrics and diagnostics"},"shortDesc":{"cs":"Profesionální diagnostika všech značek, opravy autoelektriky a online diagnostika.","ua":"Професійна діагностика всіх марок, ремонт автоелектрики та онлайн діагностика.","ru":"Профессиональная диагностика всех марок, ремонт автоэлектрики и онлайн-диагностика.","en":"Professional diagnostics for all brands, auto electrical repairs and online diagnostics."},"intro":{"cs":"Řešíme elektronické závady od základní diagnostiky po složité zásahy do elektroinstalace.","ua":"Усуваємо електронні несправності від базової діагностики до складного ремонту електропроводки.","ru":"Устраняем электронные неисправности от базовой диагностики до сложного ремонта проводки.","en":"We resolve electronic faults from basic diagnostics to complex wiring repairs."},"pricingNote":{"cs":"Cena se odvíjí od rozsahu měření a náročnosti konkrétní opravy.","ua":"Ціна залежить від обсягу перевірки та складності ремонту.","ru":"Цена зависит от объема проверки и сложности ремонта.","en":"Pricing depends on diagnostic scope and repair complexity."},"tags":["Diagnostika","Elektrika","Online"],"items":[{"id":"diagnostika","title":{"cs":"Diagnostika","ua":"Діагностика","ru":"Диагностика","en":"Diagnostics"},"description":{"cs":["Moderní diagnostické zařízení pro všechny značky vozidel.","Čtení a mazání chybových kódů, testování řídicích jednotek."],"ua":["Сучасне діагностичне обладнання для всіх марок авто.","Зчитування й видалення кодів помилок, тест блоків керування."],"ru":["Современное диагностическое оборудование для всех марок авто.","Считывание и удаление кодов ошибок, тест блоков управления."],"en":["Modern diagnostic equipment for all vehicle brands.","Reading and clearing fault codes, control unit testing."]},"priceRange":{"cs":"Orientačně 800 až 2 500 Kč","ua":"Орієнтовно 800 - 2 500 Kč","ru":"Ориентировочно 800 - 2 500 Kč","en":"Approx. CZK 800-2,500"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]},{"id":"autoelektrika","title":{"cs":"Autoelektrika","ua":"Автоелектрика","ru":"Автоэлектрика","en":"Auto electrics"},"description":{"cs":["Opravy kabeláže, alternátorů, startérů, světel, baterií a dalších elektrických systémů."],"ua":["Ремонт проводки, генераторів, стартерів, освітлення, акумуляторів та інших електросистем."],"ru":["Ремонт проводки, генераторов, стартеров, освещения, аккумуляторов и других электросистем."],"en":["Repairs of wiring, alternators, starters, lights, batteries and other electrical systems."]},"priceRange":{"cs":"Orientačně 1 200 až 25 000 Kč","ua":"Орієнтовно 1 200 - 25 000 Kč","ru":"Ориентировочно 1 200 - 25 000 Kč","en":"Approx. CZK 1,200-25,000"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]},{"id":"online-diagnostika","title":{"cs":"Online diagnostika","ua":"Онлайн діагностика","ru":"Онлайн-диагностика","en":"Online diagnostics"},"description":{"cs":["Aktualizace softwaru a řešení elektronických problémů pomocí přímého připojení k výrobcům."],"ua":["Оновлення ПЗ та вирішення електронних проблем через пряме підключення до виробників."],"ru":["Обновление ПО и решение электронных проблем через прямое подключение к производителям."],"en":["Software updates and electronic issue resolution via direct manufacturer connection."]},"priceRange":{"cs":"Orientačně 1 500 až 7 000 Kč","ua":"Орієнтовно 1 500 - 7 000 Kč","ru":"Ориентировочно 1 500 - 7 000 Kč","en":"Approx. CZK 1,500-7,000"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]}]}}]
