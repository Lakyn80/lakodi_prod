7:["$","$L12",null,{"service":{"id":"kodovani","slug":"kodovani","iconName":"KeyRound","title":{"cs":"Kódování","ua":"Кодування","ru":"Кодирование","en":"Coding"},"shortDesc":{"cs":"Kódování klíčů a řídicích jednotek pro všechny typy vozidel.","ua":"Кодування ключів та блоків керування для всіх типів автомобілів.","ru":"Кодирование ключей и блоков управления для всех типов автомобилей.","en":"Key and control unit coding for all vehicle types."},"intro":{"cs":"Zajišťujeme programování klíčů i kódování řídicích jednotek po výměně nebo opravě dílů.","ua":"Виконуємо програмування ключів і кодування блоків керування після заміни або ремонту вузлів.","ru":"Выполняем программирование ключей и кодирование блоков управления после замены или ремонта узлов.","en":"We provide key programming and control unit coding after part replacement or repair."},"pricingNote":{"cs":"Cena závisí na značce vozidla, typu jednotky a zabezpečení.","ua":"Ціна залежить від марки авто, типу блока та рівня захисту.","ru":"Цена зависит от марки авто, типа блока и уровня защиты.","en":"Pricing depends on vehicle brand, unit type and security level."},"tags":["Klíče","Řídicí jednotky"],"items":[{"id":"kodovani-klicu","title":{"cs":"Kódování klíčů","ua":"Кодування ключів","ru":"Кодирование ключей","en":"Key coding"},"description":{"cs":["Programování nových klíčů a dálkových ovladačů, párování s vozidlem."],"ua":["Програмування нових ключів і брелоків, прив'язка до автомобіля."],"ru":["Программирование новых ключей и брелоков, привязка к автомобилю."],"en":["Programming new keys and remotes, pairing with the vehicle."]},"priceRange":{"cs":"Orientačně 2 000 až 9 000 Kč","ua":"Орієнтовно 2 000 - 9 000 Kč","ru":"Ориентировочно 2 000 - 9 000 Kč","en":"Approx. CZK 2,000-9,000"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]},{"id":"ridici-jednotky","title":{"cs":"Řídicí jednotky","ua":"Блоки керування","ru":"Блоки управления","en":"Control units"},"description":{"cs":["Kódování a přizp