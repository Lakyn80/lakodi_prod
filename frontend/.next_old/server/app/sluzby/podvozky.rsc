7:["$","$L12",null,{"service":{"id":"podvozky","slug":"podvozky","iconName":"Disc","title":{"cs":"Podvozky","ua":"Підвіска","ru":"Подвеска","en":"Suspension"},"shortDesc":{"cs":"Opravy a údržba podvozků, výměna tlumičů, ramen a dalších dílů.","ua":"Ремонт і обслуговування підвіски, заміна амортизаторів, важелів та інших деталей.","ru":"Ремонт и обслуживание подвески, замена амортизаторов, рычагов и других деталей.","en":"Suspension repairs and maintenance, including shocks, control arms and other components."},"intro":{"cs":"Kontrolujeme a opravujeme podvozek tak, aby auto bylo bezpečné a stabilní při každé jízdě.","ua":"Перевіряємо й ремонтуємо підвіску, щоб авто було безпечним і стабільним у русі.","ru":"Проверяем и ремонтируем подвеску, чтобы авто было безопасным и стабильным в движении.","en":"We inspect and repair suspension to keep your car safe and stable on every drive."},"pricingNote":{"cs":"Přesná cena se stanoví po kontrole vůlí a stavu jednotlivých dílů.","ua":"Точна ціна визначається після перевірки люфтів і стану деталей.","ru":"Точная цена определяется после проверки люфтов и состояния деталей.","en":"Exact pricing is determined after checking play and component condition."},"tags":["Opravy","Tlumiče","Ramena"],"items":[{"id":"opravy-podvozku","title":{"cs":"Opravy podvozku","ua":"Ремонт підвіски","ru":"Ремонт подвески","en":"Suspension repairs"},"description":{"cs":["Kompletní kontrola a oprava náprav, čepů, silentbloků a stabilizačních prvků."],"ua":["Повна перевірка та ремонт осей, шарнірів, сайлентблоків і стабілізаторів."],"ru":["Полная проверка и ремонт осей, шарниров, сайлентблоков и стабилизаторов."],"en":["Complete inspection and repair of axles, joints, bushings and stabilizer parts."]},"priceRange":{"cs":"Orientačně 2 000 až 30 000 Kč","ua":"Орієнтовно 2 000 - 30 000 Kč","ru":"Ориентировочно 2 000 - 30 000 Kč","en":"Approx. CZK 2,000-30,000"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]},{"id":"tlumice","title":{"cs":"Tlumiče","ua":"Амортизатори","ru":"Амортизаторы","en":"Shock absorbers"},"description":{"cs":["Výměna tlumičů a pružin pro bezpečnou a stabilní jízdu."],"ua":["Заміна амортизаторів і пружин для безпечної та стабільної їзди."],"ru":["Замена амортизаторов и пружин для безопасной и стабильной езды."],"en":["Replacement of shocks and springs for safe and stable driving."]},"priceRange":{"cs":"Orientačně 4 000 až 20 000 Kč","ua":"Орієнтовно 4 000 - 20 000 Kč","ru":"Ориентировочно 4 000 - 20 000 Kč","en":"Approx. CZK 4,000-20,000"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]},{"id":"ramena","title":{"cs":"Ramena","ua":"Важелі","ru":"Рычаги","en":"Control arms"},"description":{"cs":["Výměna ramen náprav a dalších mechanických částí podvozku."],"ua":["Заміна важелів підвіски та інших механічних елементів."],"ru":["Замена рычагов подвески и других механических элементов."],"en":["Replacement of control arms and other mechanical suspension components."]},"priceRange":{"cs":"Orientačně 3 500 až 18 000 Kč","ua":"Орієнтовно 3 500 - 18 000 Kč","ru":"Ориентировочно 3 500 - 18 000 Kč","en":"Approx. CZK 3,500-18,000"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]}]}}]
