7:["$","$L12",null,{"service":{"id":"karoserie","slug":"karoserie-lakovani","iconName":"Paintbrush","title":{"cs":"Karosářské a lakýrnické práce","ua":"Кузовні та малярні роботи","ru":"Кузовные и малярные работы","en":"Body and Paint Work"},"shortDesc":{"cs":"Opravy karoserií, rovnání, svařování, lakování a leštění.","ua":"Ремонт кузова, рихтування, зварювання, фарбування та полірування.","ru":"Ремонт кузова, рихтовка, сварка, покраска и полировка.","en":"Body repairs, straightening, welding, painting and polishing."},"intro":{"cs":"Provádíme opravy po nehodách i estetické zásahy včetně lakování a profesionálního leštění.","ua":"Виконуємо ремонт після ДТП та естетичні роботи, включно з фарбуванням і професійним поліруванням.","ru":"Выполняем ремонт после ДТП и эстетические работы, включая покраску и профессиональную полировку.","en":"We handle accident repairs and cosmetic work including painting and professional polishing."},"pricingNote":{"cs":"Konečná cena závisí na velikosti poškození a použité lakovací technologii.","ua":"Кінцева ціна залежить від масштабу пошкодження та обраної технології фарбування.","ru":"Итоговая цена зависит от масштаба повреждений и выбранной технологии покраски.","en":"Final pricing depends on damage extent and selected paint technology."},"tags":["Karoserie","Lakování","Leštění"],"items":[{"id":"karoserie","title":{"cs":"Karoserie","ua":"Кузов","ru":"Кузов","en":"Bodywork"},"description":{"cs":["Opravy po nehodách, rovnání deformovaných částí, svařování a výměna dílů."],"ua":["Ремонт після ДТП, рихтування деформованих частин, зварювання та заміна деталей."],"ru":["Ремонт после ДТП, рихтовка деформированных частей, сварка и замена деталей."],"en":["Post-accident repairs, straightening deformed parts, welding and part replacement."]},"priceRange":{"cs":"Orientačně 4 000 až 80 000 Kč","ua":"Орієнтовно 4 000 - 80 000 Kč","ru":"Ориентировочно 4 000 - 80 000 Kč","en":"Approx. CZK 4,000-80,000"},"gallery":["/services/karoserie-lakovani/renovace-mercedes-01.webp","/services/karoserie-lakovani/renovace-mercedes-02.webp","/services/karoserie-lakovani/renovace-mercedes-03.webp","/services/karoserie-lakovani/renovace-mercedes-04.webp"]},{"id":"lakovani","title":{"cs":"Lakování","ua":"Фарбування","ru":"Покраска","en":"Painting"},"description":{"cs":["Lokální i celkové lakování vozidla, opravy škrábanců a poškození laku."],"ua":["Локальне або повне фарбування авто, усунення подряпин і пошкоджень покриття."],"ru":["Локальная или полная покраска авто, устранение царапин и повреждений покрытия."],"en":["Spot or full vehicle painting, scratch and paint damage repairs."]},"priceRange":{"cs":"Orientačně 2 500 až 70 000 Kč","ua":"Орієнтовно 2 500 - 70 000 Kč","ru":"Ориентировочно 2 500 - 70 000 Kč","en":"Approx. CZK 2,500-70,000"},"gallery":["/services/karoserie-lakovani/renovace-mercedes-05.webp","/services/karoserie-lakovani/renovace-mercedes-06.webp","/services/karoserie-lakovani/renovace-mercedes-07.webp","/services/karoserie-lakovani/renovace-mercedes-08.webp"]},{"id":"lesteni","title":{"cs":"Leštění","ua":"Полірування","ru":"Полировка","en":"Polishing"},"description":{"cs":["Profesionální leštění laku pro obnovení lesku a odstranění drobných vad."],"ua":["Професійне полірування для відновлення блиску та усунення дрібних дефектів."],"ru":["Профессиональная полировка для восстановления блеска и удаления мелких дефектов."],"en":["Professional paint polishing to restore gloss and remove minor defects."]},"priceRange":{"cs":"Orientačně 1 500 až 8 000 Kč","ua":"Орієнтовно 1 500 - 8 000 Kč","ru":"Ориентировочно 1 500 - 8 000 Kč","en":"Approx. CZK 1,500-8,000"},"gallery":["/services/karoserie-lakovani/renovace-mercedes-09.webp","/services/karoserie-lakovani/renovace-mercedes-10.webp","/services/karoserie-lakovani/renovace-mercedes-11.webp","/services/karoserie-lakovani/renovace-mercedes-12.webp"]}]}}]
