7:["$","$L12",null,{"service":{"id":"geometrie","slug":"geometrie","iconName":"Target","title":{"cs":"3D Geometrie","ua":"3D Розвал-сходження","ru":"3D Развал-схождение","en":"3D Wheel Alignment"},"shortDesc":{"cs":"Přesné nastavení geometrie kol na moderním 3D zařízení.","ua":"Точне налаштування геометрії коліс на сучасному 3D обладнанні.","ru":"Точная настройка геометрии колес на современном 3D оборудовании.","en":"Precise wheel alignment adjustment using modern 3D equipment."},"intro":{"cs":"Přesné 3D měření geometrie zlepšuje stabilitu vozu a prodlužuje životnost pneumatik.","ua":"Точне 3D-вимірювання геометрії покращує стабільність авто та подовжує ресурс шин.","ru":"Точное 3D-измерение геометрии улучшает устойчивость авто и продлевает срок службы шин.","en":"Accurate 3D alignment measurement improves vehicle stability and extends tire life."},"pricingNote":{"cs":"Cena závisí na typu nápravy a rozsahu nutného seřízení.","ua":"Ціна залежить від типу осі та обсягу потрібного регулювання.","ru":"Цена зависит от типа оси и объема необходимой регулировки.","en":"Pricing depends on axle type and required adjustment scope."},"tags":["3D","Geometrie"],"items":[{"id":"3d-nastaveni-geometrie-kol","title":{"cs":"3D nastavení geometrie kol","ua":"3D налаштування геометрії коліс","ru":"3D настройка геометрии колес","en":"3D wheel alignment setup"},"description":{"cs":["Přesné měření a nastavení sbíhavosti, odklonu a záklonu kol pomocí moderní 3D technologie.","Zajišťuje rovnoměrné opotřebení pneumatik a stabilní jízdní vlastnosti."],"ua":["Точне вимірювання та налаштування сходження, розвалу й кастера за допомогою сучасної 3D-технології.","Забезпечує рівномірний знос шин і стабільну керованість."],"ru":["Точное измерение и настройка схождения, развала и кастера с помощью современной 3D-технологии.","Обеспечивает равномерный износ шин и стабильную управляемость."],"en":["Precise measurement and adjustment of toe, camber and caster using modern 3D technology.","Ensures even tire wear and stable driving behavior."]},"priceRange":{"cs":"Orientačně 1 200 až 2 500 Kč","ua":"Орієнтовно 1 200 - 2 500 Kč","ru":"Ориентировочно 1 200 - 2 500 Kč","en":"Approx. CZK 1,200-2,500"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]}]}}]
