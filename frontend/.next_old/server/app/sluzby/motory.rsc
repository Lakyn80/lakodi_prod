7:["$","$L12",null,{"service":{"id":"motory","slug":"motory","iconName":"Gauge","title":{"cs":"Motory","ua":"Двигуни","ru":"Двигатели","en":"Engines"},"shortDesc":{"cs":"Generální opravy a repasy motorů – benzín, diesel, hybrid.","ua":"Капітальний ремонт двигунів – бензин, дизель, гібрид.","ru":"Капитальный ремонт двигателей - бензин, дизель, гибрид.","en":"Complete engine overhauls and rebuilds - petrol, diesel, hybrid."},"intro":{"cs":"Provádíme diagnostiku a opravy motorů od dílčích repasí až po kompletní generální opravy.","ua":"Проводимо діагностику та ремонт двигунів від часткового ремонту до повного капітального ремонту.","ru":"Выполняем диагностику и ремонт двигателей: от частичных работ до полного капитального ремонта.","en":"We provide engine diagnostics and repairs from partial rebuilds to complete overhauls."},"pricingNote":{"cs":"Orientační ceny se liší podle typu motoru, rozsahu poškození a dostupnosti dílů.","ua":"Орієнтовні ціни залежать від типу двигуна, масштабу пошкодження та доступності запчастин.","ru":"Ориентировочные цены зависят от типа двигателя, объема повреждений и доступности запчастей.","en":"Indicative prices vary by engine type, damage scope and parts availability."},"tags":["GO","Repas","Benzín","Diesel"],"items":[{"id":"go-motoru","title":{"cs":"Generální oprava (GO) motoru","ua":"Капітальний ремонт двигуна","ru":"Капитальный ремонт двигателя","en":"Complete engine overhaul"},"description":{"cs":["Kompletní rozebrání motoru, kontrola bloku a hlavy válců, výměna pístních kroužků, ložisek klikové hřídele, ventilů a těsnění.","Zahrnuje výbrus válců, broušení kliky a kompletní seřízení.","Určeno při vysoké spotřebě oleje, ztrátě výkonu nebo zadření motoru."],"ua":["Повне розбирання двигуна, перевірка блоку та головки, заміна поршневих кілець, вкладишів, клапанів і ущільнень.","Включає розточування циліндрів, шліфування колінвала та повне налаштування.","Рекомендовано при великій витраті оливи, втраті потужності або заклинюванні двигуна."],"ru":["Полная разборка двигателя, проверка блока и головки, замена поршневых колец, вкладышей, клапанов и уплотнений.","Включает расточку цилиндров, шлифовку коленвала и полную настройку.","Рекомендуется при высоком расходе масла, потере мощности или заклинивании двигателя."],"en":["Complete engine teardown, inspection of block and cylinder head, replacement of piston rings, crankshaft bearings, valves and seals.","Includes cylinder honing/boring, crankshaft grinding and full adjustment.","Recommended for high oil consumption, power loss, or seized engine."]},"priceRange":{"cs":"Orientačně 45 000 až 140 000 Kč","ua":"Орієнтовно 45 000 - 140 000 Kč","ru":"Ориентировочно 45 000 - 140 000 Kč","en":"Approx. CZK 45,000-140,000"},"gallery":["/services/motory/go-motoru-01.webp","/services/motory/go-motoru-02.webp","/services/motory/go-motoru-03.webp","/services/motory/go-motoru-04.webp","/services/motory/go-motoru-05.webp","/services/motory/go-motoru-06.webp","/services/motory/go-motoru-07.webp","/services/motory/go-motoru-08.webp","/services/motory/go-motoru-09.webp","/services/motory/go-motoru-10.webp","/services/motory/go-motoru-11.webp","/services/motory/go-motoru-12.webp","/services/motory/go-motoru-13.webp","/services/motory/go-motoru-14.webp","/services/motory/go-motoru-15.webp"]},{"id":"repas-motoru","title":{"cs":"Repas motoru","ua":"Частковий ремонт двигуна","ru":"Частичный ремонт двигателя","en":"Engine rebuild"},"description":{"cs":["Oprava konkrétní části motoru bez kompletní generální opravy.","Nejčastěji hlava válců, rozvody nebo turbo."],"ua":["Ремонт конкретної частини двигуна без повного капремонту.","Найчастіше: головка блока, ГРМ або турбіна."],"ru":["Ремонт конкретной части двигателя без полного капремонта.","Чаще всего: головка блока, ГРМ или турбина."],"en":["Repair of a specific engine section without a full overhaul.","Most often cylinder head, timing system, or turbo."]},"priceRange":{"cs":"Orientačně 12 000 až 60 000 Kč","ua":"Орієнтовно 12 000 - 60 000 Kč","ru":"Ориентировочно 12 000 - 60 000 Kč","en":"Approx. CZK 12,000-60,000"},"gallery":["/services/motory/repas-motoru-01.webp","/services/motory/repas-motoru-02.webp"]},{"id":"benzinove-motory","title":{"cs":"Benzínové motory","ua":"Бензинові двигуни","ru":"Бензиновые двигатели","en":"Petrol engines"},"description":{"cs":["Diagnostika vstřikování, zapalování a rozvodů.","Řešení ztráty výkonu, nestabilního chodu a zvýšené spotřeby."],"ua":["Діагностика системи впорскування, запалювання та ГРМ.","Усунення втрати потужності, нестабільної роботи та підвищеної витрати."],"ru":["Диагностика системы впрыска, зажигания и ГРМ.","Устранение потери мощности, нестабильной работы и повышенного расхода."],"en":["Diagnostics of injection, ignition and timing systems.","Fixing power loss, unstable running and increased fuel consumption."]},"priceRange":{"cs":"Orientačně 2 000 až 35 000 Kč","ua":"Орієнтовно 2 000 - 35 000 Kč","ru":"Ориентировочно 2 000 - 35 000 Kč","en":"Approx. CZK 2,000-35,000"},"gallery":["/placeholder.svg","/placeholder.svg","/placeholder.svg"]},{"id":"dieselove-motory","title":{"cs":"Dieselové motory","ua":"Дизельні двигуни","ru":"Дизельные двигатели","en":"Diesel engines"},"description":{"cs":["Opravy vstřikovačů, čerpadel a turbodmychadel.","Servis DPF filtrů a systémů EGR."],"ua":["Ремонт форсунок, паливних насосів і турбокомпресорів.","Обслуговування DPF-фільтрів і систем EGR."],"ru":["Ремонт форсунок, топливных насосов и турбокомпрессоров.","Обслуживание DPF-фильтров и систем EGR."],"en":["Repairs of injectors, pumps and turbochargers.","Service of DPF filters and EGR systems."]},"priceRange":{"cs":"Orientačně 3 500 až 50 000 Kč","ua":"Орієнтовно 3 500 - 50 000 Kč","ru":"Ориентировочно 3 500 - 50 000 Kč","en":"Approx. CZK 3,500-50,000"},"gallery":["/services/motory/repas-motoru-01.webp","/services/motory/repas-motoru-02.webp"]}]}}]
