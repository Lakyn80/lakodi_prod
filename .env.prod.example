# Lakodi production env sample
# Copy to .env.prod and fill with real values.

COMPOSE_PROJECT_NAME=lakodi-production

BACKEND_IMAGE=ghcr.io/vas-org/lakodi-backend
FRONTEND_IMAGE=ghcr.io/vas-org/lakodi-frontend
IMAGE_TAG=main
PREVIOUS_IMAGE_TAG=

BACKEND_BIND_PORT=8016
FRONTEND_BIND_PORT=8090

BACKEND_HEALTHCHECK_URL=http://127.0.0.1:8016/api/health
FRONTEND_HEALTHCHECK_URL=http://127.0.0.1:8090

DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/data/uploads
REDIS_URL=redis://lakodi-redis:6379/0
ARES_PROVIDER=real

# Public API URL used by frontend (production domain)
NEXT_PUBLIC_API_URL=https://api.vase-domena.cz

# Allowed origins for backend CORS (comma-separated)
CORS_ORIGINS=https://vase-domena.cz,https://www.vase-domena.cz

ADMIN_EMAIL=admin@vase-domena.cz
ADMIN_PASSWORD=zmente-na-silne-heslo
ADMIN_RECOVERY_TOKEN=zmente-na-dlouhy-nahodny-token
ADMIN_RECOVERY_EMAILS=admin@vase-domena.cz
RESEND_API_KEY=re_xxxxx
ADMIN_FROM_EMAIL=Lakodi <noreply@vase-domena.cz>
ADMIN_RECOVERY_BASE_URL=https://vase-domena.cz
ADMIN_COOKIE_SECURE=true

# SMTP je volitelné, pokud neposíláte přes Resend
SMTP_HOST=
SMTP_PORT=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# Na produkci ponechte real ARES:
# ARES_PROVIDER=real
