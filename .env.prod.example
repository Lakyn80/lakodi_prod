# Lakodi production env sample
# Copy to .env.prod and fill with real values.

COMPOSE_PROJECT_NAME=lakodi-production

BACKEND_IMAGE=ghcr.io/vas-org/lakodi-backend
FRONTEND_IMAGE=ghcr.io/vas-org/lakodi-frontend
IMAGE_TAG=main
PREVIOUS_IMAGE_TAG=

BACKEND_BIND_PORT=8016
FRONTEND_BIND_PORT=8090

BACKEND_HEALTHCHECK_URL=http://127.0.0.1:8016/api/health
FRONTEND_HEALTHCHECK_URL=http://127.0.0.1:8090

DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/data/uploads
REDIS_URL=redis://lakodi-redis:6379/0
ARES_PROVIDER=real
INVOICE_OWNER_EMAIL=lakodi@seznam.cz
INVOICE_PAYMENT_METHOD=Převodem
INVOICE_BANK_ACCOUNT_NUMBER=5997826359
INVOICE_BANK_CODE=0800

# Public API URL used by frontend (production domain)
NEXT_PUBLIC_API_URL=https://api.vase-domena.cz

# Allowed origins for backend CORS (comma-separated)
CORS_ORIGINS=https://vase-domena.cz,https://www.vase-domena.cz,https://admin.vase-domena.cz

ADMIN_EMAIL=admin@vase-domena.cz
ADMIN_PASSWORD=zmente-na-silne-heslo
ADMIN_RECOVERY_TOKEN=zmente-na-dlouhy-nahodny-token
ADMIN_RECOVERY_EMAILS=admin@vase-domena.cz
RESEND_API_KEY=re_xxxxx
ADMIN_FROM_EMAIL=Lakodi <noreply@vase-domena.cz>
ADMIN_RECOVERY_BASE_URL=https://admin.vase-domena.cz
BOOKING_ADMIN_BASE_URL=https://admin.vase-domena.cz
BOOKING_NOTIFICATION_EMAIL=lakodi@seznam.cz
ADMIN_COOKIE_SECURE=true

# SMTP je volitelné, pokud neposíláte přes Resend
SMTP_HOST=
SMTP_PORT=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# Volitelně lze změnit číslo pro ruční WhatsApp odkaz v adminu
WHATSAPP_NUMBER=420776053625

# --- AI Agent Accounting (S2S connector + admin BFF) -------------------------
# AI → Lakodi internal API
AI_ACCOUNTING_SERVICE_TOKEN_SECRET=
AI_ACCOUNTING_EXPECTED_TENANT_ID=
AI_ACCOUNTING_ALLOWED_KEY_ID=
AI_ACCOUNTING_TOKEN_ISSUER=ai-agent-accounting
AI_ACCOUNTING_TOKEN_AUDIENCE=lakodi-internal-accounting
AI_ACCOUNTING_MAX_TOKEN_TTL_SECONDS=300
# Lakodi admin BFF → AI platform (mint short-lived AI_AUTH JWT; never expose to browser)
AI_AUTH_TOKEN_ISSUER=lakodi-host
AI_AUTH_TOKEN_AUDIENCE=ai-agent-accounting
AI_AUTH_KEY_ID=
AI_AUTH_SIGNING_SECRET=
AI_AUTH_TENANT_ID=
AI_AUTH_TOKEN_TTL_SECONDS=300
AI_AUTH_DEFAULT_SCOPES=ai.chat,lakodi.invoices.read,lakodi.payments.read,lakodi.customers.read
AI_AGENT_BASE_URL=
AI_AGENT_TIMEOUT_SECONDS=60

# Na produkci ponechte real ARES:
# ARES_PROVIDER=real
