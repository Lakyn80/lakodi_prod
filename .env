# Lakodi production env sample
# Copy to .env.prod and fill with real values.

DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/data/uploads

# Public API URL used by frontend (production domain)
NEXT_PUBLIC_API_URL=https://lakodi.cz

# Allowed origins for backend CORS (comma-separated)
CORS_ORIGINS=https://lakodi.cz,https://www.lakodi.cz

ADMIN_EMAIL=lakodi@seznam.cz
ADMIN_PASSWORD=admin123
ADMIN_RECOVERY_TOKEN=zmente-na-dlouhy-nahodny-token
ADMIN_RECOVERY_EMAILS=lakodi@seznam.cz
RESEND_API_KEY=
ADMIN_FROM_EMAIL=Lakodi <lakodi@seznam.cz>
ADMIN_RECOVERY_BASE_URL=https://lakodi.cz
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_USER=lakodi@seznam.cz
SMTP_PASSWORD=S9i&GyFK:fQR.UX
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# Docker Hub repos (separátní FE/BE image)
DOCKERHUB_FE_REPO=lakyn80/lakodi-frontend
DOCKERHUB_BE_REPO=lakyn80/lakodi-beckend

# Server deploy (ssh)
DEPLOY_SERVER_USER=lucky
DEPLOY_SERVER_HOST=89.221.214.140
DEPLOY_SERVER_PATH=/opt/lakodi
DEPLOY_SSH_KEY_PATH=
DEPLOY_DB_LOCAL_PATH=.\data\app.db
