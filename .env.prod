# Lakodi production env sample
# Copy to .env.prod and fill with real values.

DATABASE_URL=sqlite:////app/data/app.db
UPLOAD_DIR=/app/data/uploads

# Public API URL used by frontend (production domain)
NEXT_PUBLIC_API_URL=https://api.vase-domena.cz

# Allowed origins for backend CORS (comma-separated)
CORS_ORIGINS=https://vase-domena.cz,https://www.vase-domena.cz

ADMIN_EMAIL=admin@vase-domena.cz
ADMIN_PASSWORD=zmente-na-silne-heslo
ADMIN_RECOVERY_TOKEN=zmente-na-dlouhy-nahodny-token
ADMIN_RECOVERY_EMAILS=admin@vase-domena.cz
RESEND_API_KEY=re_xxxxx
ADMIN_FROM_EMAIL=Lakodi <noreply@vase-domena.cz>
ADMIN_RECOVERY_BASE_URL=https://vase-domena.cz
